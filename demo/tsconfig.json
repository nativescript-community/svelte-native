{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2020",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noEmitHelpers": true,
        "noEmitOnError": true,
        "skipLibCheck": true,
        "lib": [
            "ESNext",
            "dom"
        ],
        "baseUrl": ".",
        "types": ["svelte"],
        "paths": {
            "@/*": [
                "app/*"
            ],
            "~/*": [
                "app/*"
            ]
        }
    },
    "include": [
        "app/**/*"
    ],
    "exclude": [
        "app/tests/",
        "node_modules",
        "platforms"
    ]
}