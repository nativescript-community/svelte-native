{
  "name": "@nativescript-community/svelte-native",
  "version": "5.0.0-rc.0",
  "description": "Svelte integration for NativeScript",
  "sideEffects": false,
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/nativescript-community/svelte-native.git"
  },
  "homepage": "https://github.com/nativescript-community/svelte-native",
  "keywords": [
    "nativescript",
    "svelte"
  ],
  "scripts": {
    "release": "standard-version",
    "clean": "npx rimraf ./dist/*",
    "build": "npm run clean && rollup -c && node ./scripts/create-pkg.js",
    "watch": "rollup -cw",
    "deploy": "npm run build && cd dist && npm publish",
    "deploy-beta": "npm run build && cd dist && npm publish --tag beta",
    "test": "vitest run"
  },
  "author": "David Pershouse",
  "license": "MIT",
  "peerDependencies": {
    "@nativescript/core": "^8.0.0 || ^9.0.0",
    "svelte": "^5.59.0"
  },
  "devDependencies": {
    "@nativescript/core": "~9.0.0",
    "@nativescript/types": "~9.0.0",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-typescript": "11.1.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/node": "^22.12.0",
    "glob": "10.3.10",
    "rimraf": "2.7.1",
    "rollup": "4.18.0",
    "rollup-plugin-svelte": "7.2.3",
    "standard-version": "9.5.0",
    "svelte": "5.59.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "magic-string": "^0.30.17"
  }
}
